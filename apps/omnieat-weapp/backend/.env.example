# Database
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="dapoer_super_secret_jwt_key_change_in_production"

# App URLs
APP_URL="http://localhost:10080"
ALLOWED_ORIGINS="http://localhost:10080,http://localhost:3000"

# Google OAuth (for EN region)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3001/api/auth/google"

# WeChat OAuth (for CN region)
WECHAT_APP_ID="your-wechat-app-id"
WECHAT_APP_SECRET="your-wechat-app-secret"
WECHAT_REDIRECT_URI="http://localhost:3001/api/auth/wechat"

# Stripe (for payments)
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"

# Sentry (for error logging)
SENTRY_DSN="your-sentry-dsn"

# Rate Limiting
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"
