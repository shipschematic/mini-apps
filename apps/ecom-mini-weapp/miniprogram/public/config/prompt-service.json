  "pages": [
    {
      "id": "home",
      "type": "grid",
      "title": "Featured Prompts",
      "dataSource": {
        "type": "static",
        "data": [
          {
            "id": "prod-001",
            "title": "Digital Productivity Suite",
            "description": "Complete productivity toolkit for professionals",
            "price": 99,
            "originalPrice": 149,
            "type": "digital",
            "deliveryMethod": "download",
            "category": "productivity",
            "cover": "/assets/images/logo.png",
            "status": "published",
            "rating": 4.8,
            "reviewCount": 124
          },
          {
            "id": "prod-002",
            "title": "Health Tracker Pro",
            "description": "Advanced health and fitness tracking app",
            "price": 49,
            "originalPrice": 79,
            "type": "digital",
            "deliveryMethod": "download",
            "category": "health",
            "cover": "/assets/images/logo.png",
            "status": "published",
            "rating": 4.6,
            "reviewCount": 89
          },
          {
            "id": "prod-003",
            "title": "E-Book Bundle: Complete Collection",
            "description": "500+ e-books on business, tech, and self-improvement",
            "price": 29,
            "originalPrice": 99,
            "type": "digital",
            "deliveryMethod": "download",
            "category": "digital-products",
            "cover": "/assets/images/logo.png",
            "status": "published",
            "rating": 4.9,
