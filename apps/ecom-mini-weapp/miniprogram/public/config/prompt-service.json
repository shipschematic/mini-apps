          },
          {
            "id": "prod-004",
            "title": "Premium Icon Pack",
            "description": "2000+ vector icons for designers and developers",
            "price": 19,
            "originalPrice": 39,
            "type": "digital",
            "deliveryMethod": "download",
            "category": "design",
            "cover": "/assets/images/logo.png",
            "status": "published",
            "rating": 4.7,
            "reviewCount": 67
          }
        ]
      },
      "itemTemplate": "ProductCard",
      "columns": 1,
      "actions": {
        "onItemClick": [
          { "type": "navigate", "payload": { "target": "detail", "params": { "id": "{{item.id}}" } } }
        ],
        "onUnlock": [
          { "type": "purchase", "payload": { "productId": "{{item.id}}", "price": "{{item.price}}", "title": "{{item.title}}" } },
          { "type": "showToast", "payload": { "title": "Purchase successful!", "icon": "success" } }
        ]
      }
    },
    {
      "id": "detail",
      "type": "detail",
      "title": "Prompt Details",
      "dataSource": {
        "type": "function",
        "function": "getProductById"
      },
      "layout": [
        { "component": "LockedContent", "prop": "product" }
      ]
    },
    {
      "id": "cart",
      "type": "detail",
      "title": "Shopping Cart",
      "dataSource": {
        "type": "store",
        "prop": "cart"
      },
      "layout": [
        { "component": "CartView", "prop": "items" }
      ]
    },
    {
      "id": "library",
      "type": "detail",
      "title": "My Prompts",
      "dataSource": {
        "type": "store",
        "prop": "purchasedPrompts"
      },
      "layout": [
        { "component": "DigitalLibrary", "prop": "prompts" }
      ]
    },
    {
      "id": "profile",
      "type": "detail",
      "title": "My Profile",
      "dataSource": {
        "type": "store",
        "prop": "user"
      },
      "layout": [
        { "component": "UserInfo", "prop": "profile" },
        { "component": "OrderHistory", "prop": "orders" }
      ]
    }
  ]
}
