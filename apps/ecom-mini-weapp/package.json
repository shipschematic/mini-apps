{
  "name": "taro-whitelabel-framework",
  "version": "1.0.0",
  "description": "Configuration-driven whitelabel framework for building multi-business Mini Programs with Taro",
  "repository": {
    "type": "git",
    "url": "https://github.com/velcranar/taro-whitelabel-framework.git"
  },
  "keywords": [
    "taro",
    "whitelabel",
    "mini-program",
    "wechat",
    "e-commerce",
    "configuration-driven",
    "framework"
  ],
  "author": "velcranar",
  "license": "MIT",
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "taro build --type weapp --watch",
    "build:swan": "taro build --type swan",
    "dev:swan": "taro build --type swan --watch",
    "build:alipay": "taro build --type alipay",
    "dev:alipay": "taro build --type alipay --watch",
    "build:tt": "taro build --type tt",
    "dev:tt": "taro build --type tt --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "taro build --type h5 --watch",
    "build:rn": "taro build --type rn",
    "dev:rn": "taro build --type rn --watch",
    "build:harmony": "taro build --type harmony",
    "dev:harmony": "taro build --type harmony --watch",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^1.9.7",
    "@tarojs/components": "^4.1.11",
    "@tarojs/helper": "^4.1.11",
    "@tarojs/plugin-framework-react": "^4.1.11",
    "@tarojs/plugin-platform-alipay": "^4.1.11",
    "@tarojs/plugin-platform-h5": "^4.1.11",
    "@tarojs/plugin-platform-harmony-hybrid": "^4.1.11",
    "@tarojs/plugin-platform-qq": "^4.1.11",
    "@tarojs/plugin-platform-swan": "^4.1.11",
    "@tarojs/plugin-platform-tt": "^4.1.11",
    "@tarojs/plugin-platform-weapp": "^4.1.11",
    "@tarojs/react": "^4.1.11",
    "@tarojs/router": "^4.1.11",
    "@tarojs/runtime": "^4.1.11",
    "@tarojs/shared": "^4.1.11",
    "@tarojs/taro": "^4.1.11",
    "@tarojs/taro-h5": "^4.1.11",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^8.1.0",
    "redux": "^4.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-react": "^7.22.0",
    "@babel/runtime": "^7.23.0",
    "@tarojs/cli": "^4.1.11",
    "@tarojs/webpack5-runner": "^4.1.11",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/webpack-env": "^1.18.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-preset-taro": "^4.1.11",
    "eslint": "^8.45.0",
    "eslint-config-taro": "^4.1.11",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "stylelint": "^15.10.0",
    "svgexport": "^0.4.2",
    "typescript": "^5.2.0"
  }
}
