{
  "$schema": "https://tr.designtokens.org/format/",
  "meta": {
    "source": "brand-ssot",
    "notes": "Map to ThemeData/ColorScheme on use. Keep hex in sync with SSOT."
  },
  "color": {
    "brand": {
      "harvest": { "$type": "color", "$value": "#BB9457" },
      "espresso": { "$type": "color", "$value": "#432818" },
      "rust": { "$type": "color", "$value": "#99582A" },
      "maroon": { "$type": "color", "$value": "#6F1D1B" },
      "ivory": { "$type": "color", "$value": "#EFE3D2" },
      "white": { "$type": "color", "$value": "#FFFFFF" }
    }
  },
  "app": {
    "light": {
      "colorScheme": {
        "primary": "#6F1D1B",
        "onPrimary": "#EFE3D2",
        "primaryContainer": "#8f2724",
        "onPrimaryContainer": "#F5EFE7",
        "secondary": "#99582A",
        "onSecondary": "#FFFFFF",
        "tertiary": "#BB9457",
        "onTertiary": "#432818",
        "surface": "#FFFFFF",
        "onSurface": "#2A1A10",
        "surfaceContainer": "#EFE3D2",
        "onSurfaceVariant": "#3a2a1f",
        "background": "#EFE3D2",
        "onBackground": "#2A1A10",
        "error": "#6F1D1B",
        "onError": "#EFE3D2",
        "outline": "#e6d9c6",
        "outlineVariant": "#d7c9b6",
        "shadow": "#432818",
        "scrim": "#15100b"
      }
    },
    "dark": {
      "colorScheme": {
        "primary": "#BB9457",
        "onPrimary": "#432818",
        "primaryContainer": "#6F1D1B",
        "onPrimaryContainer": "#EFE3D2",
        "secondary": "#99582A",
        "onSecondary": "#F5EFE7",
        "tertiary": "#d9b06a",
        "onTertiary": "#432818",
        "surface": "#231a14",
        "onSurface": "#F5EFE7",
        "surfaceContainer": "#15100b",
        "onSurfaceVariant": "#d7c9b6",
        "background": "#15100b",
        "onBackground": "#F5EFE7",
        "error": "#8f2724",
        "onError": "#F5EFE7",
        "outline": "#6b4a2e",
        "outlineVariant": "#3a2a1f",
        "shadow": "#000000",
        "scrim": "#000000"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "ui": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "-apple-system", "Roboto", "sans-serif"] },
      "display": { "$type": "fontFamily", "$value": ["Playfair Display", "Georgia", "serif"] }
    },
    "scale": {
      "body": "14-16sp",
      "label": "12-14sp",
      "title": "16-22sp",
      "headline": "24-34sp",
      "display": "32-40sp"
    }
  },
  "spacing": { "base": 4, "values": [4,8,12,16,24,32,48,64] },
  "shape": { "radius": { "sm": 3, "md": 4, "lg": 8, "pill": 999 } },
  "elevation": { "level0": 0, "level1": 1, "level2": 2, "level3": 4 }
}
